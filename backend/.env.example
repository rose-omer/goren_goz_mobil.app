# Gören Göz backend ortam değişkenleri. Kopyala: .env (repoya girmez).
# Bu makinede 8000, 1984, 8554, 8555 yasak.

HOST=127.0.0.1
PORT=8110
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Zorunlu (DEBUG=false iken). Uzun, rastgele bir değer üret.
API_KEY=

# Yalnız tarayıcıdaki debug sayfası için; virgülle ayır. Mobil istemci gerektirmez.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=300
# Oturum sözlüğü üst sınırı (X-Session-Id istemci denetimli)
MAX_SESSIONS=256

# Modeller (scripts/download_models.py indirir)
MODELS_DIR=./model_files
# openvino_midas | depth_anything | none
DEPTH_BACKEND=openvino_midas
# DEPTH_ANYTHING_MODEL_NAME=depth_anything_v2_small
OPENVINO_DEVICE=AUTO
# YOLO_MODEL_PATH=./model_files/yolo26n.pt

# VLM (llama-server, OpenAI uyumlu uç)
VLM_SERVER_URL=http://127.0.0.1:8120
VLM_API_KEY=
VLM_MODEL=SmolVLM2-500M-Video-Instruct
VLM_TIMEOUT_S=30
